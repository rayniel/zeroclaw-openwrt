#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

. /usr/libexec/zeroclaw-common.sh

start_service() {
    local enabled port
    zc_load_paths
    config_get_bool enabled main enabled 0
    [ "$enabled" -eq 1 ] || return 0
    zc_check_storage || {
        logger -t zeroclaw "Storage check failed; service was not started"
        return 1
    }
    if [ ! -x "$ZC_ROOT/bin/zeroclaw" ]; then
        logger -t zeroclaw "Missing binary: $ZC_ROOT/bin/zeroclaw"
        return 1
    fi
    config_get port main port 42617
    case "$port" in
        ''|*[!0-9]*) logger -t zeroclaw "Invalid port"; return 1 ;;
    esac
    if [ "${#port}" -gt 5 ] || [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
        logger -t zeroclaw "Port must be between 1 and 65535"
        return 1
    fi
    procd_open_instance
    procd_set_param command /usr/bin/zeroclaw daemon --host 127.0.0.1 --port "$port"
    procd_set_param respawn 3600 10 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param term_timeout 30
    procd_close_instance
}

service_triggers() {
    zc_load_paths
    procd_add_reload_trigger zeroclaw
    procd_add_restart_mount_trigger "$ZC_MOUNT"
}
